<% push_event = field.push_event %>

<div style="display: flex; align-items: center; gap: 0.75rem; min-width: 28rem;">
  <% if push_event.actor_avatar_url.present? %>
    <%= image_tag push_event.actor_avatar_url,
      alt: "",
      width: 40,
      height: 40,
      style: "border-radius: 50%; border: 1px solid #dfe3e8;" %>
  <% end %>

  <div style="display: grid; gap: 0.2rem;">
    <div>
      <%= link_to push_event.display_actor_login, push_event.actor_html_url, target: "_blank", rel: "noopener" %>
      pushed to
      <%= link_to push_event.repository_name, push_event.repository_html_url, target: "_blank", rel: "noopener" %>
    </div>

    <div style="color: #5c6b73; font-size: 0.875rem;">
      <% if push_event.ref_html_url.present? %>
        <%= link_to push_event.ref_label, push_event.ref_html_url, target: "_blank", rel: "noopener" %>
      <% else %>
        <%= push_event.ref_label %>
      <% end %>
      ·
      <%= link_to push_event.short_head, push_event.commit_html_url, target: "_blank", rel: "noopener" %>
      ·
      <%= link_to "compare push", push_event.push_html_url, target: "_blank", rel: "noopener" %>
      <% if push_event.enriched? %>
        · enriched
      <% end %>
    </div>
  </div>
</div>
